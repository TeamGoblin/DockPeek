# Copy to local.env (git-ignored) to customise your builds.
# Override the app bundle identifier (default: com.teamgoblin.dockpeek).
DOCKPEEK_BUNDLE_ID=com.yourname.dockpeek

# Optional: force a specific signing identity
# DOCKPEEK_SIGN_IDENTITY="Apple Development: Your Name (XXXXXXXXXX)"
# DOCKPEEK_DIST_IDENTITY="Developer ID Application: Your Company (XXXXXXXXXX)"
